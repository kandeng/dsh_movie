[Unit]
Description=ComfyUI movie-render fleet (8188 on GPU0 + instances 8189-8195 on GPU1-7)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# COMFY_ROOT is read by the launcher scripts. If you install the stack
# somewhere other than /root/comfy, set it here AND rewrite the two absolute
# ExecStart/ExecStop paths below (systemd does not expand $COMFY_ROOT there).
Environment=COMFY_ROOT=/root/comfy
WorkingDirectory=/root/comfy
ExecStart=/root/comfy/comfy_start.sh
# Stops only the additional instances (8189-8195). The 8188 instance is left
# untouched on purpose; stop it with /root/comfy/comfy_stop.sh.
ExecStop=/root/comfy/comfy_stop_multi.sh
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
