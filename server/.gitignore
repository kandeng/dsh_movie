node_modules/
*.tsbuildinfo
plugins/*/lib/

# Local env & secrets — never commit
.env
.dsh/.credentials.yaml
.dsh/.anonymous-user-id

# DSH runtime state (regenerated locally on each host boot)
.dsh/logs/
.dsh/sessions/
.dsh/storages/
.dsh/workspaces/
.dsh/profiles/*/node_modules/

# Scratch logs
*.log

# Temporary headless driver harnesses — superseded in production by the
# dsh_bot / customer_service agent that plans + draws + executes the graph.
scripts/drive-movie.ts
scripts/drive-episode-clip.ts
scripts/room-post.ts
