# dsh_movie server — credential & configuration template
#
# HOW TO USE
#   1. Copy this file to `.env` in the same directory:   cp .env.example .env
#   2. Fill in the two SECRET values marked [secret] below.
#   3. Never commit `.env` — it is gitignored. This `.env.example` IS committed
#      (it holds only names/placeholders, no real secrets).
#
# At runtime the DSH "credentials seam" layers these values (stored file >
# launch env > .env). Plugin config references them by NAME only (apiKeyEnv /
# adminTokenRef), so a rotated secret takes effect on the next call with no
# code change and no host restart.

# ── LLM provider (Alibaba Bailian, OpenAI-compatible) ────────────────────────
# [secret] Your Bailian / DashScope API key (looks like: sk-xxxxxxxxxxxxxxxx).
# Referenced by server/.dsh/cordis.patch.yml -> llm-pi-ai.providers.bailian.apiKeyEnv
# Get one from the Alibaba Cloud Bailian (Model Studio) console.
BAILIAN_API_KEY=

# ── Synapse homeserver (the identity provider) ───────────────────────────────
# Base URL of the local Synapse Client-Server / Admin API. No trailing slash.
SYNAPSE_BASE_URL=http://127.0.0.1:8008

# Synapse's server_name (the part after ":" in a Matrix user id @user:server_name).
SYNAPSE_SERVER_NAME=localhost

# [secret] A Synapse *server-admin* access token, used for the Admin API
# (idempotent user provisioning, puppet-login token brokering, whoami, room
# introspection). Referenced by profiles/movie/cordis.patch.yml -> adminTokenRef.
# It usually looks like: syt_xxxxxxxxxxxx
#
# How to obtain one (local dev):
#   a) Mark your admin account in homeserver.yaml (admin: true), log in with a
#      Matrix client, and copy its access token; OR
#   b) Mint one via the Admin API using an existing admin token:
#        POST /_synapse/admin/v1/users/@<admin>:localhost/login
SYNAPSE_ADMIN_TOKEN=

# The agent bot's Matrix user id. The chat plugin boots a matrix-js-sdk client
# as this user; it must already exist in Synapse (provision it once, or let the
# identity plugin create it). Format: @localpart:server_name
SYNAPSE_BOT_USER_ID=@vidsay_bot:localhost

# Optional. A pre-existing room id (!xxxx:server_name) for the demo/verify
# scripts and the web client to open directly. Leave empty to have the client
# create a fresh room on login. `pnpm seed:demo` prints a seeded room id.
SYNAPSE_ROOM_ID=
