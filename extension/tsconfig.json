{
  // Typecheck config for the extension operator scripts (lives OUTSIDE
  // extension/comfy on purpose: that directory holds docs + the optional
  // comfy-remote MCP bridge for the EXTERNAL H20 ComfyUI service, not a
  // bundled/built service of this repo).
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "typeRoots": ["./comfy/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["comfy/src/**/*.ts"]
}
